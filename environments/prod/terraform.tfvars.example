# 本番環境用の設定例

# プロジェクト設定
project_id = "gcp-runpod-gpu-lab"

# リージョン・ゾーン設定（本番環境用）
region = "asia-northeast1"
zone   = "asia-northeast1-a"

# VM設定（本番環境用）
machine_type = "e2-small"
disk_size = 20

# SSH設定（既存鍵を使用）
ssh_username = "ubuntu"
ssh_public_key_path = "~/.ssh/id_rsa.pub"
use_generated_ssh_key = false

# 監視設定（本番環境では有効化）
enable_monitoring = true